{
  "name": "vsp360-mcp",
  "version": "0.1.5",
  "description": "MCP server for the Hitachi VSP 360 1.4 REST API, generated from its OpenAPI spec",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vsp360-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "eval": "npm run build && node tests/search-eval.mjs",
    "decision-report": "node tests/decision-report.mjs",
    "train-decision": "node tests/train-decision.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.16.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "typescript": "5.9.3"
  }
}
