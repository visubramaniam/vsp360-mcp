{
  "name": "vsp360-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Hitachi VSP 360 1.4 REST API, generated from its OpenAPI spec",
  "type": "module",
  "bin": { "vsp360-mcp": "dist/index.js" },
  "files": ["dist", "spec"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "7.16.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "typescript": "5.9.3"
  }
}
