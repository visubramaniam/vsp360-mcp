{
  "name": "vsp360-mcp",
  "version": "0.1.21",
  "description": "Community MCP server for Hitachi VSP 360: the VSP 360 1.4 REST API for Claude and other MCP clients. Not an official Hitachi Vantara product.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vsp360-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec",
    "INSTALL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/cache-spec.mjs",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "eval": "npm run build && node tests/search-eval.mjs",
    "decision-report": "node tests/decision-report.mjs",
    "collect-batch": "node tests/collect-batch.mjs",
    "train-decision": "node tests/train-decision.mjs",
    "test": "npm run build && node --test \"tests/unit/*.test.mjs\" && node tests/search-eval.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "8.11.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@types/node": "22.18.8",
    "typescript": "5.9.3"
  },
  "author": "Vinod Subramaniam",
  "homepage": "https://github.com/visubramaniam/vsp360-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visubramaniam/vsp360-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/visubramaniam/vsp360-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "hitachi",
    "vsp360",
    "storage"
  ]
}
